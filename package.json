{
  "name": "the-oak-music-bot",
  "version": "1.0.0",
  "description": "The oak music bot",
  "main": "index.js",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.10",
    "axios": "^1.19.0",
    "discord.js": "14.18.0",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "0.7.11",
    "youtube-dl-exec": "^3.1.17"
  },
  "scripts": {
    "bot": "node index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "the-oak-music-bot"
  },
  "keywords": [
    "the",
    "oak",
    "music",
    "bot"
  ],
  "author": "Jack Schofield",
  "license": "ISC",
  "devDependencies": {
    "jest": "^27.5.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!index.js"
    ]
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.10": true
  }
}
